        // observada pode começar pelo commit mais antigo.
        return '';
    }

    async function getFileTree(projectId, ref, signal) {
        const query = ref ? `?ref=${encodeURIComponent(ref)}` : '';
        const payload = await apiFetchJson(
            `/projects/${projectId}/git/files${query}`,
            { signal },
            { retries: MAX_RETRIES }
        );
        return Array.isArray(payload?.files) ? payload.files : [];
    }

    function validateFileList(files) {
        if (files.length === 0) {
            throw new Error('A API retornou uma lista vazia de arquivos.');
        }
        if (files.length > MAX_ZIP32_FILES) {
            throw new Error(`O projeto contém ${files.length} arquivos e ultrapassa o limite ZIP32 de ${MAX_ZIP32_FILES}.`);
        }

        const seen = new Set();
        for (const file of files) {
            if (!file || typeof file.path !== 'string' || !file.path.trim()) {
                throw new Error('A API retornou uma entrada de arquivo inválida.');
            }
            const normalized = normalizeZipPath(file.path);
            if (seen.has(normalized)) {
                throw new Error(`A API retornou um caminho duplicado: ${normalized}`);
            }
            seen.add(normalized);
        }
    }

    async function downloadFile(projectId, ref, file, signal) {
        const path = normalizeZipPath(file.path);
        const refQuery = ref ? `&ref=${encodeURIComponent(ref)}` : '';
        const endpoint = `/projects/${projectId}/git/file?path=${encodeURIComponent(path)}${refQuery}`;
        const response = await apiFetch(endpoint, { signal }, { retries: MAX_RETRIES });
        const contentType = (response.headers.get('content-type') || '').toLowerCase();
        const bytes = new Uint8Array(await response.arrayBuffer());

        // Arquivos JSON normais devem ser preservados byte a byte. Só tentamos
        // interpretar um envelope JSON quando a árvore marcou o arquivo como binário.
        if (file.binary && contentType.includes('application/json')) {
            const decoded = new TextDecoder().decode(bytes);
            try {
                const json = JSON.parse(decoded);
                if (isWrappedFilePayload(json)) {
                    return decodeJsonFilePayload(json, path, signal);
                }
            } catch (_) {
                // Se não for um envelope conhecido, mantém os bytes originais.
            }
        }

        if (file.binary && looksLikeBinaryPlaceholder(bytes)) {
            throw new Error(`A API devolveu apenas um marcador de binário para ${path}.`);
        }

        return bytes;
    }

    function isWrappedFilePayload(payload) {
        if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return false;

        const hasEncodedContent = typeof payload.encoding === 'string' &&
            (typeof payload.content === 'string' || typeof payload.data === 'string');
        const hasRemoteUrl = [
            payload.download_url, payload.downloadUrl, payload.signed_url,
            payload.signedUrl, payload.url
        ].some(value => typeof value === 'string' && /^https?:\/\//i.test(value));

        return hasEncodedContent || hasRemoteUrl;
    }

    async function decodeJsonFilePayload(payload, path, signal) {
        if (typeof payload === 'string') return new TextEncoder().encode(payload);

        if (typeof payload?.content === 'string') {
            if (/base64/i.test(payload?.encoding || '')) return base64ToBytes(payload.content);
            return new TextEncoder().encode(payload.content);
        }

        if (typeof payload?.data === 'string') {
            if (/base64/i.test(payload?.encoding || '') || looksLikeBase64(payload.data)) {
                return base64ToBytes(payload.data);
            }
            return new TextEncoder().encode(payload.data);
        }

        const remoteUrl = payload?.download_url || payload?.downloadUrl || payload?.signed_url || payload?.signedUrl || payload?.url;
        if (typeof remoteUrl === 'string' && /^https?:\/\//i.test(remoteUrl)) {
            const response = await fetchWithRetry(remoteUrl, { credentials: 'omit', signal }, MAX_RETRIES, signal);
            return new Uint8Array(await response.arrayBuffer());
        }

        throw new Error(`Formato de conteúdo não reconhecido para ${path}.`);
    }

    async function apiFetchJson(path, init, options) {
        const response = await apiFetch(path, init, options);
        const text = await response.text();
        try {
            return JSON.parse(text);
        } catch (_) {
            throw new Error(`A API retornou JSON inválido em ${path}.`);
        }
    }

    async function apiFetch(path, init = {}, { retries = MAX_RETRIES } = {}) {
        const url = path.startsWith('http') ? path : `${API_ORIGIN}${path}`;
        const headers = new Headers(init.headers || {});
        headers.set('Accept', headers.get('Accept') || '*/*');
        if (state.authHeader) headers.set('Authorization', state.authHeader);

        const response = await fetchWithRetry(
            url,
            {
